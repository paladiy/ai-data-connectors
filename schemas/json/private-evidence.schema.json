{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string"
          },
          "internal_ref": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "checked_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vendor_docs",
              "directory",
              "product_test",
              "internal_docs"
            ]
          },
          "public": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "checked_on",
          "kind",
          "public"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_id",
    "evidence"
  ],
  "additionalProperties": false
}
