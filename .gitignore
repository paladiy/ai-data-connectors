# Plans and internal documents: local only, never commit.
# Anchored to the repository root so they cannot shadow application directories
# such as site/src/content/docs.
/docs/
/briefs/
/plans/
/research/
/.cursor/
/.claude/
/data/private/
*.private.md
*.internal.md

/reports/

# Throwaway trees used by the build integration test
/.tmp/

# Dependencies and tooling
node_modules/
.DS_Store
*.log
coverage/
.astro/

# Generated site content and builds (regenerated by npm run generate)
site/dist/
site/.astro/
site/src/generated/
site/src/content/docs/index.mdx
site/src/content/docs/sources/
site/public/connectors.json
site/public/llms.txt
site/public/robots.txt
