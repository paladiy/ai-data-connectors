---
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default><slot /></Default>

<script>
  const radios = () => Array.from(document.querySelectorAll<HTMLInputElement>(".sp-radio"));

  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const panel = target?.closest<HTMLElement>(".sp-panel");
    const option = panel?.dataset.option ?? (id.startsWith("route-") ? id : undefined);
    const radio = radios().find((r) => r.dataset.option === option || r.id === id);
    if (!radio) return;
    radio.checked = true;
    if (target && panel) target.scrollIntoView();
  }

  function init() {
    const all = radios();
    if (all.length === 0) return;
    openFromHash();
    for (const radio of all) {
      radio.addEventListener("change", () => {
        history.replaceState(null, "", `#${radio.id}`);
      });
    }
    window.addEventListener("hashchange", openFromHash);

    const tabs = document.querySelector(".sp-tabs");
    const wrap = document.querySelector(".sp-switch");
    if (tabs && wrap && "IntersectionObserver" in window) {
      wrap.classList.add("sp-js");
      const top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--sl-nav-height")) * 16 || 64;
      new IntersectionObserver(([entry]) => wrap.classList.toggle("sp-away", !entry.isIntersecting), {
        rootMargin: `-${top}px 0px 0px 0px`,
      }).observe(tabs);
    }
  }

  init();

  const TOOL_KEY = "sp-ai-tool";

  function selectTool(id: string | null): boolean {
    if (!id) return false;
    const matches = Array.from(document.querySelectorAll<HTMLInputElement>(".sp-tool-radio")).filter(
      (radio) => radio.value === id,
    );
    for (const radio of matches) radio.checked = true;
    return matches.length > 0;
  }

  function initTools() {
    const fromHash = decodeURIComponent(location.hash.slice(1)).match(/^tool-(.+)$/)?.[1] ?? null;
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(TOOL_KEY);
    } catch {}
    if (!selectTool(fromHash)) selectTool(stored);

    document.addEventListener("change", (event) => {
      const radio = event.target as HTMLInputElement;
      if (!radio.classList?.contains("sp-tool-radio")) return;
      try {
        localStorage.setItem(TOOL_KEY, radio.value);
      } catch {}
    });
  }

  initTools();
</script>

<script>
  // Related skills: the cards are rendered at build time from the pinned snapshot. The live
  // coupler-io/skills index replaces them only when it lists different skills for this source.
  import { matchSkills, renderSkillCards, SKILLS_INDEX_URL, toSkillCard, type IndexedSkill, type SkillCard } from "../lib/skills.ts";

  async function refreshSkills() {
    const box = document.querySelector<HTMLElement>(".sp-skills");
    if (!box) return;
    try {
      const names: string[] = JSON.parse(box.dataset.skillsNames ?? "[]");
      const recorded: SkillCard[] = JSON.parse(box.dataset.skillsRecorded ?? "[]");
      const res = await fetch(SKILLS_INDEX_URL, { headers: { Accept: "application/json" } });
      if (!res.ok) return;
      const index = (await res.json()) as { skills?: IndexedSkill[] };
      if (!Array.isArray(index.skills) || index.skills.length === 0) return;
      const cards = [...recorded, ...matchSkills(index.skills, names).map((skill) => toSkillCard(skill, names))];
      const shown = [...box.querySelectorAll<HTMLElement>(".sk-card")].map((card) => card.dataset.skill);
      if (cards.map((card) => card.name).join("\n") === shown.join("\n")) return;
      box.innerHTML = renderSkillCards(cards, box.dataset.skillsSource ?? "");
    } catch {}
  }

  refreshSkills();
</script>
