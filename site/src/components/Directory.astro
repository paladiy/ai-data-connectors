---
import directory from "../generated/directory.json";

const METHOD_LABELS: Record<string, string> = {
  native_connector: "Native connector",
  remote_mcp: "Remote MCP",
  local_mcp: "Local MCP",
  data_platform: "Data platform",
  automation: "Automation",
  file_upload: "File export",
};

const sources = [...directory.sources].sort((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base", numeric: true }),
);

const letterOf = (name: string) => {
  const first = name.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(first) ? first : "#";
};

// Alphabetical groups. The groups exist at every size so the page reads the same with 1 or 200+ entries.
const groups: Array<{ letter: string; items: typeof sources }> = [];
for (const source of sources) {
  const letter = letterOf(source.name);
  const last = groups[groups.length - 1];
  if (last && last.letter === letter) last.items.push(source);
  else groups.push({ letter, items: [source] });
}

const methodCounts = new Map<string, number>();
for (const source of sources) for (const m of source.methods) methodCounts.set(m, (methodCounts.get(m) ?? 0) + 1);
const methods = [...methodCounts.entries()]
  .sort((a, b) => (METHOD_LABELS[a[0]] ?? a[0]).localeCompare(METHOD_LABELS[b[0]] ?? b[0]))
  .map(([id, count]) => ({ id, label: METHOD_LABELS[id] ?? id, count }));

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#".split("");
const present = new Set(groups.map((g) => g.letter));
---

<section class="dx" aria-labelledby="dx-heading" data-view="list">
  <div class="dx-toolbar">
    <h2 id="dx-heading" class="sr-only">Find a data source</h2>

    <div class="dx-row">
      <div class="dx-search">
        <label for="dx-search-input" class="sr-only">Search by source, alias, or provider</label>
        <input
          id="dx-search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={`Search ${sources.length} ${sources.length === 1 ? "source" : "sources"}, for example GA4`}
          aria-describedby="dx-count"
        />
        <kbd class="dx-key" aria-hidden="true">/</kbd>
      </div>

      <div class="dx-views" role="group" aria-label="Layout">
        <button type="button" data-view-option="list" aria-pressed="true">List</button>
        <button type="button" data-view-option="grid" aria-pressed="false">Grid</button>
        <button type="button" data-view-option="index" aria-pressed="false">Index</button>
      </div>
    </div>

    {
      methods.length > 0 && (
        <div class="dx-filters" role="group" aria-label="Filter by connection method">
          <span class="dx-filters-label">Method</span>
          {methods.map((m) => (
            <button type="button" class="dx-chip" data-method={m.id} aria-pressed="false">
              {m.label} <span class="dx-chip-count">{m.count}</span>
            </button>
          ))}
          <button type="button" class="dx-clear" hidden>Clear filters</button>
        </div>
      )
    }

  </div>

  <div class="dx-meta">
    <nav class="dx-letters" aria-label="Jump to letter">
      {
        alphabet.map((letter) =>
          present.has(letter) ? (
            <a href={`#dx-${letter === "#" ? "other" : letter}`} data-letter={letter}>
              {letter}
            </a>
          ) : (
            <span class="dx-letter-off" aria-hidden="true">
              {letter}
            </span>
          ),
        )
      }
    </nav>

    <p id="dx-count" class="dx-count" role="status" aria-live="polite">
      {sources.length} {sources.length === 1 ? "source" : "sources"}
    </p>
  </div>

  {
    sources.length === 0 ? (
      <p class="dx-empty">No sources have been added yet.</p>
    ) : (
      <div class="dx-groups">
        {groups.map((group) => (
          <section class="dx-group" id={`dx-${group.letter === "#" ? "other" : group.letter}`} data-group>
            <h3 class="dx-letter">{group.letter}</h3>
            <ul class="dx-list" role="list">
              {group.items.map((source) => (
                <li
                  class="dx-item"
                  data-name={source.name.toLowerCase()}
                  data-aliases={source.aliases.join(" ").toLowerCase()}
                  data-providers={[...new Set(source.providers)].join(" ").toLowerCase()}
                  data-methods={source.methods.join(" ")}
                >
                  <a class="dx-name" href={`/sources/${source.slug}/`}>
                    {source.name}
                  </a>
                  <p class="dx-summary">{source.summary}</p>
                  <ul class="dx-tags" role="list" aria-label="Connection methods">
                    {source.methods.map((id) => (
                      <li>{METHOD_LABELS[id] ?? id}</li>
                    ))}
                  </ul>
                  <span class="dx-routes">
                    <span class="dx-routes-n">{source.routes}</span>{" "}
                    {source.routes === 1 ? "route" : "routes"}
                  </span>
                  {source.aliases.length > 0 && (
                    <p class="dx-aliases">Also searched as {source.aliases.join(", ")}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  <p class="dx-noresults" hidden>
    <strong>No source matches.</strong> Check the spelling, try the product's short name, or
    <button type="button" class="dx-clear-inline">clear the search and filters</button>.
  </p>

  <p class="dx-foot"><a href="/about/">About this directory</a></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>(".dx");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("#dx-search-input")!;
    const items = [...root.querySelectorAll<HTMLElement>(".dx-item")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-group]")];
    const letterLinks = [...root.querySelectorAll<HTMLAnchorElement>(".dx-letters a")];
    const chips = [...root.querySelectorAll<HTMLButtonElement>(".dx-chip")];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-view-option]")];
    const count = root.querySelector<HTMLElement>("#dx-count")!;
    const noResults = root.querySelector<HTMLElement>(".dx-noresults")!;
    const clear = root.querySelector<HTMLButtonElement>(".dx-clear");
    const clearInline = root.querySelector<HTMLButtonElement>(".dx-clear-inline")!;
    const total = items.length;
    const VIEWS = ["list", "grid", "index"];
    const active = new Set<string>();

    function setView(view: string, persist = true) {
      if (!VIEWS.includes(view)) view = "list";
      root!.dataset.view = view;
      for (const b of viewButtons) b.setAttribute("aria-pressed", String(b.dataset.viewOption === view));
      if (persist) {
        try {
          localStorage.setItem("dx-view", view);
        } catch {}
      }
    }

    function sync() {
      const url = new URL(location.href);
      const q = input.value.trim();
      q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
      active.size ? url.searchParams.set("method", [...active].join(",")) : url.searchParams.delete("method");
      history.replaceState(null, "", url);
    }

    function apply() {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;

      for (const item of items) {
        const haystack = `${item.dataset.name} ${item.dataset.aliases} ${item.dataset.providers}`;
        const textMatch = terms.every((t) => haystack.includes(t));
        const methodMatch = active.size === 0 || [...active].some((m) => item.dataset.methods!.split(" ").includes(m));
        const show = textMatch && methodMatch;
        item.hidden = !show;
        if (show) visible += 1;
      }

      const live = new Set<string>();
      for (const group of groups) {
        const any = group.querySelector(".dx-item:not([hidden])") !== null;
        group.hidden = !any;
        if (any) live.add(group.querySelector<HTMLElement>(".dx-letter")!.textContent!);
      }
      for (const a of letterLinks) {
        const on = live.has(a.dataset.letter!);
        a.toggleAttribute("aria-disabled", !on);
        a.classList.toggle("is-off", !on);
        a.tabIndex = on ? 0 : -1;
      }

      const filtered = terms.length > 0 || active.size > 0;
      count.textContent = filtered
        ? `${visible} of ${total} ${total === 1 ? "source" : "sources"}`
        : `${total} ${total === 1 ? "source" : "sources"}`;
      noResults.hidden = visible > 0 || total === 0;
      if (clear) clear.hidden = !filtered;
      sync();
    }

    function resetAll() {
      input.value = "";
      active.clear();
      for (const c of chips) c.setAttribute("aria-pressed", "false");
      apply();
      input.focus();
    }

    input.addEventListener("input", apply);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && input.value) {
        e.preventDefault();
        input.value = "";
        apply();
      }
    });
    for (const c of chips) {
      c.addEventListener("click", () => {
        const id = c.dataset.method!;
        active.has(id) ? active.delete(id) : active.add(id);
        c.setAttribute("aria-pressed", String(active.has(id)));
        apply();
      });
    }
    for (const b of viewButtons) b.addEventListener("click", () => setView(b.dataset.viewOption!));
    clear?.addEventListener("click", resetAll);
    clearInline.addEventListener("click", resetAll);

    // Press "/" anywhere outside a field to start searching.
    document.addEventListener("keydown", (e) => {
      const el = e.target as HTMLElement | null;
      const typing = el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
      if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });

    // Restore state: URL first, then the last layout the reader chose.
    const params = new URLSearchParams(location.search);
    let stored: string | null = null;
    try {
      stored = localStorage.getItem("dx-view");
    } catch {}
    setView(params.get("view") ?? stored ?? "list", false);
    input.value = params.get("q") ?? "";
    for (const id of (params.get("method") ?? "").split(",").filter(Boolean)) {
      const chip = chips.find((c) => c.dataset.method === id);
      if (chip) {
        active.add(id);
        chip.setAttribute("aria-pressed", "true");
      }
    }
    apply();
  }
</script>
