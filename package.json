{
  "name": "ai-data-connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Static editorial directory of ways to connect business data sources to AI assistants and agents.",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/check-generated.ts",
    "check:private": "tsx scripts/check-private.ts",
    "check:links": "tsx scripts/check-links.ts site/dist",
    "schemas:export": "tsx scripts/export-json-schemas.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:private && vitest run",
    "build": "npm run validate && npm run generate && astro build --root site && npm run check:links",
    "preview": "astro preview --root site",
    "dev": "npm run generate && astro dev --root site"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/starlight": "0.42.5",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
